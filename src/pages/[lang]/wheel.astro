---
import Base from '../../layouts/Base.astro';
import { LANGS, UI, SIGN_TEXT, TERMS, INFO } from '../../lib/content.js';
import { SIGNS, glyph } from '../../lib/zodiac.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
const t = UI[lang];
const T = TERMS[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fmt = (d) => new Date(2001, d[0] - 1, d[1]).toLocaleDateString(t.locale, { day: 'numeric', month: 'short' });
const ELEMENTS = ['fire', 'earth', 'air', 'water'];

// Traditional layout: Aries at 9 o'clock, signs running counter-clockwise.
const R1 = 230, R2 = 370;
const pt = (r, deg) => [r * Math.cos((deg * Math.PI) / 180), -r * Math.sin((deg * Math.PI) / 180)].map((v) => +v.toFixed(2));
const segment = (i) => {
  const a0 = 180 + i * 30, a1 = a0 + 30;
  const [o0, o1, i1, i0] = [pt(R2, a0), pt(R2, a1), pt(R1, a1), pt(R1, a0)];
  return `M${o0} A${R2},${R2} 0 0 0 ${o1} L${i1} A${R1},${R1} 0 0 1 ${i0}Z`;
};
const ticks = Array.from({ length: 72 }, (_, k) => [pt(380, k * 5), pt(k % 6 ? 388 : 396, k * 5)]);
---
<Base lang={lang} path="wheel/" title={`${t.wheelTitle} · StarSigned`} description={t.wheelSub}>
  <main>
    <section class="wheel-page">
      <header class="wheel-head">
        <p class="eyebrow reveal" style="--i:0">{t.signsTitle}</p>
        <h1 class="hero-heading reveal" style="--i:1">{t.wheelTitle}</h1>
        <p class="hero-sub reveal" style="--i:2">{t.wheelSub}</p>
      </header>

      <div class="filters reveal" style="--i:3" role="group" aria-label={t.element}>
        <button type="button" data-filter="" aria-pressed="true">{t.filterAll}</button>
        {ELEMENTS.map((e) => <button type="button" class={e} data-filter={e} aria-pressed="false">{T[e]}</button>)}
      </div>

      <div class="zodiac" data-zodiac>
        <svg class="zodiac-svg" viewBox="-400 -400 800 800" role="img" aria-label={t.wheelTitle}>
          <g data-ticks>
            {ticks.map(([a, b]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} />)}
          </g>
          <circle r={R2} class="ring" />
          <circle r={R1} class="ring" />
          <circle r="205" class="ring dashed" />
          <g data-rotor>
            {SIGNS.map((s, i) => {
              const [x, y] = pt(300, 195 + i * 30);
              return (
                <a href={`${base}${lang}/${s.id}/`} class={`seg ${s.element}`} data-id={s.id} aria-label={SIGN_TEXT[lang][s.id].name}>
                  <path d={segment(i)} />
                  <g transform={`translate(${x} ${y})`}>
                    <g data-label>
                      <text class="seg-glyph" y="-10">{glyph(s)}</text>
                      <text class="seg-name" y="30">{SIGN_TEXT[lang][s.id].name}</text>
                    </g>
                  </g>
                </a>
              );
            })}
          </g>
        </svg>

        <div class="zodiac-center" aria-live="polite">
          {SIGNS.map((s) => (
            <div class={`zodiac-info ${s.element}`} data-info={s.id} hidden={s.id !== 'aries'}>
              <span class="zi-glyph" aria-hidden="true">{glyph(s)}</span>
              <strong class="zi-name">{SIGN_TEXT[lang][s.id].name}</strong>
              <span class="zi-dates">{fmt(s.start)} – {fmt(s.end)}</span>
              <span class="zi-meta">{T[s.element]} · {T[s.modality]} · {T[s.planet]}</span>
              <a class="zi-link" href={`${base}${lang}/${s.id}/`}>{t.discover} →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <header class="section-head" data-reveal><h2>{t.elementsTitle}</h2></header>
      <div class="elements stagger" data-reveal>
        {ELEMENTS.map((e) => (
          <article class={`deep-card ${e}`}>
            <p class="eyebrow">{t.element}</p>
            <h3>{T[e]}</h3>
            <p>{INFO[lang].element[e].split('. ').slice(0, 2).join('. ')}.</p>
            <ul class="element-signs">
              {SIGNS.filter((s) => s.element === e).map((s) => (
                <li>
                  <a href={`${base}${lang}/${s.id}/`}>
                    <span class="glyph" aria-hidden="true">{glyph(s)}</span>
                    <span>{SIGN_TEXT[lang][s.id].name}</span>
                    <span class="muted small">{fmt(s.start)} – {fmt(s.end)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  import { signFor } from '../../lib/zodiac.js';

  const root = document.querySelector('[data-zodiac]');
  const svg = root.querySelector('svg');
  const rotor = root.querySelector('[data-rotor]');
  const ticks = root.querySelector('[data-ticks]');
  const labels = [...root.querySelectorAll('[data-label]')];
  const segs = [...root.querySelectorAll('.seg')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const show = (id) => {
    root.querySelectorAll('[data-info]').forEach((el) => (el.hidden = el.dataset.info !== id));
    segs.forEach((s) => s.classList.toggle('active', s.dataset.id === id));
  };
  const now = new Date();
  show(signFor(now.getMonth() + 1, now.getDate()).id);

  // Rotation state, degrees. Base drift is slow; hover eases it to a stop, a drag flings it.
  const BASE = still ? 0 : -4;
  let angle = 0, speed = BASE, target = BASE, last = performance.now();
  let drag = null;
  let pointerType = 'mouse';
  let previewed = null;

  const render = () => {
    rotor.setAttribute('transform', `rotate(${angle})`);
    ticks.setAttribute('transform', `rotate(${-angle * 0.4})`);
    labels.forEach((l) => l.setAttribute('transform', `rotate(${-angle})`)); // keep labels upright
  };
  const frame = (t) => {
    const dt = Math.min(0.05, (t - last) / 1000);
    last = t;
    if (!drag) {
      speed += (target - speed) * Math.min(1, dt * 2.5); // exponential settle toward target speed
      angle += speed * dt;
      render();
    }
    requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);

  const pointerAngle = (e) => {
    const r = svg.getBoundingClientRect();
    return (Math.atan2(e.clientY - r.top - r.height / 2, e.clientX - r.left - r.width / 2) * 180) / Math.PI;
  };
  svg.addEventListener('pointerdown', (e) => {
    pointerType = e.pointerType;
    if (drag) return; // ignore extra touches
    drag = { a: pointerAngle(e), t: performance.now(), moved: 0, v: 0, id: e.pointerId };
  });
  svg.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const a = pointerAngle(e);
    const d = ((a - drag.a + 540) % 360) - 180;
    const tt = performance.now();
    drag.moved += Math.abs(d);
    if (drag.moved > 4 && !svg.hasPointerCapture(e.pointerId)) svg.setPointerCapture(e.pointerId);
    drag.v = (d / Math.max(1, tt - drag.t)) * 1000;
    Object.assign(drag, { a, t: tt });
    angle += d;
    render();
  });
  const release = (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    if (drag.moved > 4) {
      speed = Math.max(-720, Math.min(720, drag.v)); // fling, then settle back to drift
      svg.addEventListener('click', (c) => c.preventDefault(), { capture: true, once: true });
    }
    target = BASE;
    drag = null;
  };
  svg.addEventListener('pointerup', release);
  svg.addEventListener('pointercancel', release);

  segs.forEach((s) => {
    const enter = () => (show(s.dataset.id), (target = 0));
    s.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && enter());
    s.addEventListener('focus', enter);
    s.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && (target = BASE));
    s.addEventListener('blur', () => (target = BASE));
    // Touch: first tap previews the sign in the centre, second tap opens it.
    // Tracked separately from .active, because focus (fired before click) already marks it active.
    s.addEventListener('click', (e) => {
      if (pointerType === 'mouse' || previewed === s.dataset.id) return;
      e.preventDefault();
      previewed = s.dataset.id;
      show(previewed);
      target = 0;
    });
  });

  root.parentElement.querySelectorAll('[data-filter]').forEach((b, _, all) =>
    b.addEventListener('click', () => {
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      svg.dataset.filter = b.dataset.filter;
      const first = segs.find((s) => !b.dataset.filter || s.classList.contains(b.dataset.filter));
      if (b.dataset.filter) show(first.dataset.id);
    }),
  );
</script>
