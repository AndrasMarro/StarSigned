---
import Base from '../../layouts/Base.astro';
import { LANGS, UI, SIGN_TEXT, TERMS } from '../../lib/content.js';
import { SIGNS, glyph, rng, today } from '../../lib/zodiac.js';
import { skyHTML, dailyListHTML } from '../../lib/render.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fmt = (s) => new Date(2001, s[0] - 1, s[1]).toLocaleDateString(t.locale, { day: 'numeric', month: 'short' });

// Deterministic star field for the hero backdrop.
const r = rng('stars');
const stars = Array.from({ length: 110 }, () => ({ x: r() * 100, y: r() * 100, s: 0.4 + r() * 1.2, o: 0.15 + r() * 0.6 }));
---
<Base lang={lang} title={`StarSigned · ${t.tagline}`} description={t.heroSub}>
  <main>
    <section class="hero">
      <svg class="starfield" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {stars.map((p) => <circle cx={p.x} cy={p.y} r={p.s / 10} opacity={p.o} />)}
      </svg>
      <svg class="wheel" viewBox="-320 -320 640 640" aria-hidden="true">
        <circle r="310" /><circle r="240" /><circle r="160" class="faint" />
        {SIGNS.map((s, i) => {
          const a = (i * 30 - 90) * (Math.PI / 180);
          const g = a + (15 * Math.PI) / 180;
          return (
            <>
              <line x1={240 * Math.cos(a)} y1={240 * Math.sin(a)} x2={310 * Math.cos(a)} y2={310 * Math.sin(a)} />
              <text x={275 * Math.cos(g)} y={275 * Math.sin(g)}>{glyph(s)}</text>
            </>
          );
        })}
      </svg>

      <div class="hero-content">
        <p class="eyebrow reveal" style="--i:0">{t.eyebrow}</p>
        <h1 class="hero-heading reveal" style="--i:1">{t.heroA} <em>{t.heroB}</em></h1>
        <p class="hero-sub reveal" style="--i:2">{t.heroSub}</p>
        <form class="finder reveal" style="--i:3" data-finder data-lang={lang} data-base={base}>
          <label class="sr-only" for="birthday">{t.birthday}</label>
          <input id="birthday" name="d" type="date" required min="1900-01-01" max={today()} aria-describedby="finder-error" />
          <button class="cta" type="submit">{t.reveal}</button>
          <p id="finder-error" class="finder-error" role="alert" hidden>{t.invalid}</p>
        </form>
      </div>
    </section>

    <section class="section" id="today">
      <header class="section-head" data-reveal>
        <h2>{t.skyTitle}</h2>
        <p class="muted">{t.skySub}</p>
      </header>
      <div class="sky" data-reveal data-sky set:html={skyHTML(lang, new Date())} />
    </section>

    <section class="section">
      <header class="section-head" data-reveal><h2>{t.dailyTitle}</h2></header>
      <div class="daily-list stagger" data-reveal data-daily-list set:html={dailyListHTML(lang, today(), base)} />
    </section>

    <section class="section">
      <header class="section-head" data-reveal><h2>{t.signsTitle}</h2></header>
      <ul class="sign-grid stagger" data-reveal>
        {SIGNS.map((s) => (
          <li>
            <a class={`sign-card ${s.element}`} href={`${base}${lang}/${s.id}/`}>
              <span class="glyph" style={`view-transition-name:g-${s.id}`} aria-hidden="true">{glyph(s)}</span>
              <span class="sign-name">{SIGN_TEXT[lang][s.id].name}</span>
              <span class="muted small">{fmt(s.start)} – {fmt(s.end)} · {TERMS[lang][s.element]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<script>
  import { birthInfo, today } from '../../lib/zodiac.js';
  import { skyHTML, dailyListHTML } from '../../lib/render.js';

  const form = document.querySelector('[data-finder]');
  const { lang, base } = form.dataset;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const iso = form.elements.d.value;
    const b = birthInfo(iso);
    form.querySelector('.finder-error').hidden = !!b;
    if (b) location.href = `${base}${lang}/${b.sign.id}/?d=${iso}`;
  });

  // Refresh build-time content with the visitor's local date.
  document.querySelector('[data-sky]').innerHTML = skyHTML(lang, new Date());
  document.querySelector('[data-daily-list]').innerHTML = dailyListHTML(lang, today(), base);
</script>
